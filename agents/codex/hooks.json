{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/qdm_codex_hook.py context",
            "statusMessage": "Loading QDM Harness context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|shell_command|functions\\.shell_command|powershell",
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/qdm_codex_hook.py posttool",
            "statusMessage": "Updating QDM Harness state"
          }
        ]
      }
    ]
  }
}
