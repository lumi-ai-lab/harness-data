# Generate a real encrypted blob (one line, no comments) for local authz testing:
#
#   cd /path/to/qdm-metric-cli
#   go run ./scripts/auth_blob_encrypt.go -in test/auth.json > /path/to/harness-data/config/dev-auth.blob
#
# Then set in config/harness-config.yaml (dev only):
#
#   authz:
#     mode: on
#     blob_file: config/dev-auth.blob
#     dev_user_id: local-test-user   # required when using blob_file; no code default
#     allow_local_blob: true
#
# Production should use Host _auth + _auth_user_id and allow_local_blob: false.
# Do not commit config/dev-auth.blob (gitignored).
