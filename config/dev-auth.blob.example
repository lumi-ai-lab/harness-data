# Working copy for local authz (gitignored). Prefer the installer:
#
#   npx @lumi-ai-lab/harness-data install --data-auth
#
# That copies config/fixtures/local-test-auth.blob → config/dev-auth.blob and sets:
#
#   authz:
#     mode: on
#     blob_file: config/dev-auth.blob
#     dev_user_id: local-test-user
#     allow_local_blob: true
#
# Manual regenerate:
#
#   cd /path/to/qdm-metric-cli
#   go run ./scripts/auth_blob_encrypt.go \
#     -in /path/to/harness-data/config/fixtures/local-test-auth.json \
#     > /path/to/harness-data/config/dev-auth.blob
#
# Production should use Host _auth + _auth_user_id (optionally allow_local_blob: false).
# Do not commit config/dev-auth.blob (gitignored).
