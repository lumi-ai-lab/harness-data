# Harness repository configuration.

paths:
  knowledge: wikis

cli:
  qdm_metric_cli: /absolute/path/to/qdm-metric-cli

# Optional authorization for qdm-metric-cli (default: mode off).
# Installer: `npx @lumi-ai-lab/harness-data install --auth-blob 'qdm1enc...'`
# writes mode on and atomically stores the supplied blob at config/dev-auth.blob.
# Local/production runtime supplies an encrypted blob via HARNESS_AUTH_BLOB_FILE;
# keep allow_local_blob enabled for this MVP. A legacy HARNESS_AUTH_USER_ID is
# host metadata only and is not a qdm authorization input.
# Local-only file fallback: blob_file; an existing dev_user_id is preserved on update.
authz:
  mode: off
  # blob_file: config/dev-auth.blob
  allow_local_blob: true
