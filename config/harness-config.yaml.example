# Harness repository configuration.

paths:
  knowledge: wikis

cli:
  qdm_metric_cli: /absolute/path/to/qdm-metric-cli

# Optional data-auth for qdm-metric-cli (default: mode off).
# Installer: `npx @lumi-ai-lab/harness-data install --data-auth` writes mode on +
# copies config/fixtures/local-test-auth.blob → config/dev-auth.blob.
# Production: Host sends encrypted _auth + _auth_user_id; set allow_local_blob: false.
# Local-only file fallback (dev): blob_file + dev_user_id (dev_user_id has no code default).
authz:
  mode: off
  # blob_file: config/dev-auth.blob
  # dev_user_id: local-test-user
  allow_local_blob: true
