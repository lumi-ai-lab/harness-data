# Harness Data configuration example.
# Codex Plugin users normally let the installed Plugin Setup generate this file.

paths:
  knowledge: resources/wikis

cli:
  qdm_metric_cli: /absolute/path/to/qdm-metric-cli

authz:
  mode: on
  # blob_file: /absolute/path/to/auth.blob
  # dev_user_id: your-user-id
  allow_local_blob: true
