# Harness repository configuration.

paths:
  knowledge: wikis

cli:
  qdm_metric_cli: /absolute/path/to/qdm-metric-cli

# data-auth for qdm-metric-cli (default: mode on via install).
# Default install: prompts for auth blob + dev_user_id, writes to config/dev-auth.blob.
# `install --no-auth`: requires password, writes mode off.
# `install --data-auth`: uses built-in local-test fixture blob (dev/test shortcut).
# Production: Host sends encrypted _auth + _auth_user_id; set allow_local_blob: false.
authz:
  mode: off
  # blob_file: config/dev-auth.blob
  # dev_user_id: local-test-user
  allow_local_blob: true
