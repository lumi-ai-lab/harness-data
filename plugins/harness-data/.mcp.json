{
  "mcpServers": {
    "html-report": {
      "cwd": ".",
      "command": "node",
      "args": ["./mcp/server.mjs"],
      "env_vars": [
        "CODEX_HOME",
        "PWD",
        "HARNESS_PLUGIN_ROOT",
        "HARNESS_CONTEXT_FILE",
        "CHATGPT_CONTEXT_FILE",
        "OPENAI_CONTEXT_FILE",
        "HARNESS_WORKSPACE_POLICY",
        "HARNESS_DATA_ROOT",
        "HARNESS_RESOURCE_ROOT",
        "HARNESS_SECRET_ROOT",
        "HARNESS_STATE_ROOT",
        "HARNESS_CONFIG_PATH",
        "HARNESS_SECRET_REF",
        "HARNESS_WORKSPACE_ROOT",
        "HARNESS_WORKSPACE_TRUSTED",
        "CODEX_WORKSPACE_ROOT",
        "CHATGPT_WORKSPACE_ROOT",
        "OPENAI_WORKSPACE_ROOT",
        "HARNESS_HOST",
        "CHATGPT_HOST",
        "HARNESS_SURFACE",
        "CHATGPT_SURFACE",
        "HARNESS_SESSION_ID",
        "CHATGPT_SESSION_ID",
        "OPENAI_SESSION_ID",
        "HARNESS_SUPPORTS_LOCAL_UI",
        "HARNESS_SUPPORTS_HOOKS",
        "HARNESS_CAN_WRITE_WORKSPACE",
        "HARNESS_CAN_WRITE_DATA",
        "HARNESS_READ_ONLY",
        "HARNESS_HAS_STABLE_SESSION_ID",
        "HARNESS_DESKTOP_TRANSPORT",
        "HARNESS_DESKTOP_BRIDGE",
        "HARNESS_BRIDGE_TOKEN",
        "CHATGPT_BRIDGE_TOKEN",
        "QDM_METRIC_CLI"
      ]
    }
  }
}
