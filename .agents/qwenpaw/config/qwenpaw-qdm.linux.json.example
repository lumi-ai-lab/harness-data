{
  "schema_version": 2,
  "plugin_id": "qdm-harness-qwenpaw",
  "plugin_version": "0.1.6",
  "root_context_path": "/opt/qdm/harness-data/instance/context.json",
  "secret_ref": "/run/secrets",
  "enabled_agents": ["harness-data-*"],
  "user_id_display_mode": "off",
  "tool_policy": "preserve",
  "qdm_query_mode": "shell_hook",
  "qdm_shell_hook_enabled": true,
  "qdm_shell_dialects": ["bash", "powershell"],
  "qdm_shell_cmd_enabled": false,
  "runtime_mcp": {
    "enabled": true,
    "endpoint": "http://127.0.0.1:8765/mcp",
    "token_file": "/run/secrets/qdm-auth-runtime.token",
    "timeout_seconds": 10,
    "max_response_bytes": 1048576
  },
  "context_limits": {
    "base_context_bytes": null,
    "wiki_file_bytes": null,
    "wiki_total_bytes": null
  },
  "query_limits": {
    "success_bytes": null,
    "timeout_seconds": 120
  },
  "report_limits": {
    "additional_context_bytes": null
  }
}
