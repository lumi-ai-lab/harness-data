#!/bin/sh
# Resolve a WorkBuddy-managed Node runtime and execute the hook adapter.

set -e

resolve_from_extra_paths() {
  paths=${WORKBUDDY_EXTRA_PATHS:-}
  [ -n "$paths" ] || return 1
  (
    IFS=:
    for d in $paths; do
      if [ -n "$d" ] && [ -x "$d/node" ]; then
        printf '%s\n' "$d/node"
        exit 0
      fi
    done
    exit 1
  )
}

resolve_from_node_bin_dir() {
  [ -n "${NODE_BIN_DIR:-}" ] || return 1
  [ -x "$NODE_BIN_DIR/node" ] || return 1
  printf '%s\n' "$NODE_BIN_DIR/node"
}

resolve_from_managed_dirs() {
  root=${WORKBUDDY_CONFIG_DIR:-${CODEBUDDY_CONFIG_DIR:-$HOME/.workbuddy}}
  versions_dir="$root/binaries/node/versions"
  [ -d "$versions_dir" ] || return 1

  names=""
  for dir in "$versions_dir"/*/; do
    [ -d "$dir" ] || continue
    name=${dir%/}
    name=${name##*/}
    case "$name" in
      *.installing.*|*.__extract_temp__*) continue ;;
    esac
    names="$names$name
"
  done
  [ -n "$names" ] || return 1

  for ver in $(printf '%s' "$names" | sort -Vr); do
    candidate="$versions_dir/$ver/bin/node"
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

resolve_from_path() {
  command -v node 2>/dev/null
}

NODE_BIN=$(resolve_from_node_bin_dir || resolve_from_extra_paths || resolve_from_managed_dirs || resolve_from_path || true)

if [ -z "$NODE_BIN" ]; then
  echo "[qdm-harness] cannot locate node (checked NODE_BIN_DIR, WORKBUDDY_EXTRA_PATHS, managed binaries, and PATH)" >&2
  exit 127
fi

NODE_DIR=$(dirname "$NODE_BIN")
case ":$PATH:" in
  *":$NODE_DIR:"*) ;;
  *) PATH="$NODE_DIR:$PATH"; export PATH ;;
esac

exec "$NODE_BIN" "$@"
