{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/data-harness-cli\" context --format claude-hook"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/data-harness-cli\" authz-hook --agent claude || exit 2"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/data-harness-cli\" authz-hook --agent claude || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/bin/data-harness-cli\" posttool --format claude-hook"
          }
        ]
      }
    ]
  }
}
