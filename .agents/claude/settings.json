{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HARNESS_DATA_CLI__ context --format claude-hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__HARNESS_DATA_CLI__ posttool --format claude-hook"
          }
        ]
      }
    ]
  }
}
