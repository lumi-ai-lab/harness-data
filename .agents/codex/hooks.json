{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HARNESS_DATA_CLI__ context --format codex-hook",
            "statusMessage": "Loading QDM Harness context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|shell|shell_command|functions\\.shell_command|powershell|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "__HARNESS_DATA_CLI__ posttool --format codex-hook",
            "statusMessage": "Updating QDM Harness state"
          }
        ]
      }
    ]
  }
}
