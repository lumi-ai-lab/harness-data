{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/bin/data-harness-cli\" context --format codex-hook",
            "statusMessage": "Loading QDM Harness context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/bin/data-harness-cli\" posttool --format codex-hook",
            "statusMessage": "Updating QDM Harness state"
          }
        ]
      }
    ]
  }
}
